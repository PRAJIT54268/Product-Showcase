function CTAButton(props: {
    label: string
    secondary?: boolean
    accent: string
    ariaLabel: string
}) {
    const { label, secondary, accent, ariaLabel } = props
    return (
        <button
            aria-label={ariaLabel}
            style={{
                minHeight: 46,
                padding: "12px 18px",
                borderRadius: 12,
                border: secondary ? "1px solid rgba(255,255,255,.22)" : "none",
                background: secondary
                    ? "rgba(255,255,255,.05)"
                    : `linear-gradient(135deg, ${accent}, #445bff)`,
                color: "#FFFFFF",
                fontWeight: 600,
                fontSize: 14,
                letterSpacing: "-0.01em",
                cursor: "pointer",
                transition: "transform .2s ease, filter .2s ease, background .2s ease",
            }}
        >
            {label}
        </button>
    )
}

function ProductVariantSelector(props: {
    variants: Variant[]
    selected: number
    onSelect: (index: number) => void
    accent: string
}) {
    return (
        <div style={{ display: "flex", gap: 10, flexWrap: "wrap" }}>
            {props.variants.map((variant, index) => {
                const active = index === props.selected
                return (
                    <button
                        key={variant.name}
                        onClick={() => props.onSelect(index)}
                        aria-label={`Select ${variant.name} variant`}
                        aria-pressed={active}
                        style={{
                            minHeight: 44,
                            padding: "10px 14px",
                            borderRadius: 999,
                            border: active
                                ? `1px solid ${props.accent}`
                                : "1px solid rgba(255,255,255,.2)",
                            color: "#FFFFFF",
                            background: active
                                ? "rgba(255,255,255,.16)"
                                : "rgba(255,255,255,.05)",
                            cursor: "pointer",
                            fontSize: 13,
                            fontWeight: 600,
                            transition: "all .2s ease",
                        }}
                    >
                        {variant.name}
                    </button>
                )
            })}
        </div>
    )
}

function ProductHotspot(props: {
    data: HotspotData
    active: boolean
    onClick: () => void
    accent: string
}) {
    return (
        <button
            onClick={props.onClick}
            aria-label={`Open ${props.data.title} details`}
            style={{
                position: "absolute",
                left: props.data.x,
                top: props.data.y,
                transform: "translate(-50%,-50%)",
                width: 44,
                height: 44,
                borderRadius: 999,
                border: "1px solid rgba(255,255,255,.8)",
                background: props.active ? props.accent : "rgba(255,255,255,.08)",
                color: "#FFFFFF",
                cursor: "pointer",
                boxShadow: props.active
                    ? `0 0 0 8px ${props.accent}33, 0 8px 24px rgba(0,0,0,.4)`
                    : "0 8px 24px rgba(0,0,0,.4)",
                transition: "all .2s ease",
            }}
        >
            +
        </button>
    )
}

function ProductVisual(props: {
    variant: Variant
    accent: string
    activeTarget: HotspotData["target"] | null
    reducedMotion: boolean
    pointerRotate: { x: number; y: number }
    onPointerMove: (event: React.PointerEvent<HTMLDivElement>) => void
    onPointerLeave: () => void
    onHotspotClick: (id: string) => void
    activeHotspot: string | null
}) {
    const { variant, activeTarget, accent, reducedMotion, pointerRotate } = props
    const glowFor = React.useCallback(
        (target: HotspotData["target"]) =>
            activeTarget === target ? `drop-shadow(0 0 18px ${accent})` : "none",
        [activeTarget, accent]
    )

    return (
        <div
            onPointerMove={props.onPointerMove}
            onPointerLeave={props.onPointerLeave}
            style={{
                position: "relative",
                width: "100%",
                aspectRatio: "16 / 11",
                borderRadius: 28,
                overflow: "hidden",
                transformStyle: "preserve-3d",
                transform: reducedMotion
                    ? "none"
                    : `rotateX(${pointerRotate.x}deg) rotateY(${pointerRotate.y}deg)`,
                transition: "transform .25s ease",
                background:
                    "radial-gradient(circle at 20% 20%, rgba(255,255,255,.08), transparent 26%), radial-gradient(circle at 78% 24%, rgba(121,138,255,.22), transparent 34%), linear-gradient(160deg,#0E1118,#050608)",
                boxShadow:
                    "inset 0 1px 0 rgba(255,255,255,.12), 0 40px 70px rgba(0,0,0,.5)",
                transitionProperty: "transform, background, box-shadow",
                transitionDuration: ".25s, .35s, .35s",
            }}
        >
            <svg viewBox="0 0 760 540" style={{ width: "100%", height: "100%" }}>
                <defs>
                    <linearGradient id="band" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stopColor={variant.metal} />
                        <stop offset=".3" stopColor={variant.shell} />
                        <stop offset=".7" stopColor={variant.shellDark} />
                        <stop offset="1" stopColor={variant.shell} />
                    </linearGradient>
                    <linearGradient id="cup" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stopColor={variant.shell} />
                        <stop offset=".52" stopColor={variant.shellDark} />
                        <stop offset="1" stopColor={variant.shell} />
                    </linearGradient>
                    <radialGradient id="pad" cx=".38" cy=".35">
                        <stop offset="0" stopColor={variant.cushion} />
                        <stop offset=".8" stopColor="#06080C" />
                    </radialGradient>
                </defs>
                <path
                    d="M215 270 C215 85 545 85 545 270"
                    fill="none"
                    stroke="url(#band)"
                    strokeWidth="42"
                    strokeLinecap="round"
                    style={{ filter: glowFor("headband") }}
                />
                <path
                    d="M228 267 C231 134 530 134 532 267"
                    fill="none"
                    stroke="rgba(255,255,255,.22)"
                    strokeWidth="3"
                />
                <g style={{ filter: glowFor("leftCup") }}>
                    <rect x="172" y="220" width="150" height="220" rx="74" fill="url(#cup)" />
                    <rect x="197" y="250" width="100" height="162" rx="50" fill="url(#pad)" />
                </g>
                <g style={{ filter: glowFor("rightCup") }}>
                    <rect x="438" y="220" width="150" height="220" rx="74" fill="url(#cup)" />
                    <rect x="463" y="250" width="100" height="162" rx="50" fill="url(#pad)" />
                </g>
                <ellipse
                    cx="380"
                    cy="281"
                    rx="90"
                    ry="52"
                    fill="rgba(255,255,255,.03)"
                    style={{ filter: glowFor("core") }}
                />
                <path d="M182 230 Q145 198 165 140" stroke={accent} strokeOpacity=".45" strokeWidth="3" fill="none" />
                <path d="M578 230 Q615 198 595 140" stroke={accent} strokeOpacity=".35" strokeWidth="3" fill="none" />
            </svg>

            {hotspots.map((spot) => (
                <ProductHotspot
                    key={spot.id}
                    data={spot}
                    active={spot.id === props.activeHotspot}
                    onClick={() => props.onHotspotClick(spot.id)}
                    accent={accent}
                />
            ))}
        </div>
    )
}


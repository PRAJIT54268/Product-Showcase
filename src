export default function HeadphoneShowcase(props: MyComponentProps) {
    const {
        minHeight = "100vh",
        primaryAccent = "#6D7CFF",
        theme = "Nocturne",
    } = props
    const isStatic = useIsStaticRenderer()
    const pageBackground = theme === "Arctic"
        ? "radial-gradient(circle at 14% 2%, rgba(122,156,255,.24), transparent 28%), radial-gradient(circle at 86% 14%, rgba(159,187,255,.2), transparent 26%), linear-gradient(180deg, #F5F8FF 0%, #EBF1FC 100%)"
        : "radial-gradient(circle at 15% 0%, rgba(107,123,255,.16), transparent 30%), radial-gradient(circle at 85% 15%, rgba(88,105,255,.1), transparent 28%), #06080D"
    const [selected, setSelected] = React.useState(0)
    const [activeHotspotId, setActiveHotspotId] = React.useState<string | null>(null)
    const [reducedMotion, setReducedMotion] = React.useState(false)
    const [desktopParallax, setDesktopParallax] = React.useState(false)
    const [rotate, setRotate] = React.useState({ x: 0, y: 0 })
    const selectedVariant = variants[selected]
    const activeHotspot = hotspots.find((h) => h.id === activeHotspotId) ?? null

    React.useEffect(() => {
        if (typeof window !== "undefined") {
            const reduce = window.matchMedia("(prefers-reduced-motion: reduce)")
            const desktop = window.matchMedia("(min-width: 769px)")
            const update = () => {
                React.startTransition(() => {
                    setReducedMotion(reduce.matches)
                    setDesktopParallax(desktop.matches)
                })
            }
            update()
            reduce.addEventListener("change", update)
            desktop.addEventListener("change", update)
            return () => {
                reduce.removeEventListener("change", update)
                desktop.removeEventListener("change", update)
            }
        } else {
            React.startTransition(() => {
                setReducedMotion(true)
                setDesktopParallax(false)
            })
        }
        return undefined
    }, [])

    React.useEffect(() => {
        const onKey = (event: KeyboardEvent) => {
            if (event.key === "Escape") {
                React.startTransition(() => setActiveHotspotId(null))
            }
        }
        if (typeof window !== "undefined") {
            window.addEventListener("keydown", onKey)
            return () => window.removeEventListener("keydown", onKey)
        }
        return undefined
    }, [])

    const onPointerMove = React.useCallback(
        (event: React.PointerEvent<HTMLDivElement>) => {
            if (!desktopParallax || reducedMotion || isStatic) return
            const rect = event.currentTarget.getBoundingClientRect()
            const x = (event.clientX - rect.left) / rect.width - 0.5
            const y = (event.clientY - rect.top) / rect.height - 0.5
            React.startTransition(() => setRotate({ x: y * -5, y: x * 7 }))
        },
        [desktopParallax, reducedMotion, isStatic]
    )

    const onPointerLeave = React.useCallback(() => {
        React.startTransition(() => setRotate({ x: 0, y: 0 }))
    }, [])

    return (
        <main
            className="auralis-launch"
            style={{
                position: "relative",
                width: "100%",
                minHeight,
                overflowX: "hidden",
                background: pageBackground,
                color: "#FFFFFF",
                fontFamily:
                    "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
                transition: "background .35s ease, color .35s ease",
            }}
        >
            <section style={{ position: "relative", maxWidth: 1180, margin: "0 auto", padding: "clamp(18px,4vw,60px)" }}>
                <div className="heroGrid" style={{ display: "grid", gridTemplateColumns: "minmax(0,.9fr) minmax(0,1.1fr)", gap: 28, alignItems: "center" }}>
                    <div style={{ minWidth: 0 }}>
                        <div
                            style={{
                                letterSpacing: ".24em",
                                fontSize: 11,
                                color: "#9CA4B2",
                            }}
                        >
                            AURALIS / ONE
                        </div>
                        <h1 style={{ margin: "10px 0 12px", fontSize: "clamp(40px,8vw,78px)", letterSpacing: "-.06em", lineHeight: 0.94 }}>
                            Designed for the long listen.
                        </h1>
                        <p
                            style={{
                                margin: 0,
                                color: "#B3BBC7",
                                lineHeight: 1.55,
                                maxWidth: 520,
                            }}
                        >
                            A premium wireless over-ear headphone focused on immersive sound, intelligent noise control, and all-day comfort.
                        </p>
                        <div style={{ display: "flex", gap: 10, marginTop: 18, flexWrap: "wrap" }}>
                            <CTAButton accent={primaryAccent} label="Explore Auralis" ariaLabel="Pre-order Auralis One" />
                            <CTAButton secondary accent={primaryAccent} label="View specifications" ariaLabel="Watch Auralis keynote" />
                        </div>
                        <div style={{ marginTop: 18 }}>
                            <ProductVariantSelector
                                variants={variants}
                                selected={selected}
                                onSelect={(index) => {
                                    React.startTransition(() => {
                                        setSelected(index)
                                        setActiveHotspotId(null)
                                    })
                                }}
                                accent={primaryAccent}
                            />
                        </div>
                        <div
                            style={{
                                marginTop: 10,
                                color: "#96A0AF",
                                fontSize: 13,
                            }}
                        >
                            Finish: {selectedVariant.name}
                        </div>
                    </div>

                    <div style={{ position: "relative", minWidth: 0 }}>
                        <motion.div
                            key={selectedVariant.name}
                            initial={{ opacity: 0.7, scale: 0.98 }}
                            animate={{ opacity: 1, scale: 1 }}
                            transition={{ duration: reducedMotion ? 0 : 0.3 }}
                        >
                            <ProductVisual
                                variant={selectedVariant}
                                accent={primaryAccent}
                                activeTarget={activeHotspot?.target ?? null}
                                reducedMotion={reducedMotion || !desktopParallax}
                                pointerRotate={rotate}
                                onPointerMove={onPointerMove}
                                onPointerLeave={onPointerLeave}
                                onHotspotClick={(id) =>
                                    React.startTransition(() =>
                                        setActiveHotspotId((prev) => (prev === id ? null : id))
                                    )
                                }
                                activeHotspot={activeHotspotId}
                            />
                        </motion.div>
                        <motion.aside
                            initial={{ opacity: 0, y: 8 }}
                            animate={{ opacity: activeHotspot ? 1 : 0, y: activeHotspot ? 0 : 8 }}
                            transition={{ duration: reducedMotion ? 0 : 0.2 }}
                            style={{
                                position: "absolute",
                                left: 14,
                                right: 14,
                                bottom: 14,
                                minHeight: 72,
                                borderRadius: 12,
                                border: "1px solid rgba(255,255,255,.18)",
                                background: "rgba(9,12,20,.82)",
                                backdropFilter: "blur(8px)",
                                padding: 12,
                                pointerEvents: activeHotspot ? "auto" : "none",
                                transition: "background .35s ease, border-color .35s ease",
                            }}
                        >
                            {activeHotspot && (
                                <>
                                    <div style={{ display: "flex", justifyContent: "space-between", gap: 8 }}>
                                        <strong style={{ fontSize: 14 }}>{activeHotspot.title}</strong>
                                        <button
                                            onClick={() => React.startTransition(() => setActiveHotspotId(null))}
                                            aria-label="Close feature panel"
                                            style={{
                                                minWidth: 44,
                                                minHeight: 28,
                                                borderRadius: 8,
                                                border: "1px solid rgba(255,255,255,.24)",
                                                background: "transparent",
                                                color: "#FFFFFF",
                                                cursor: "pointer",
                                            }}
                                        >
                                            Close
                                        </button>
                                    </div>
                                    <p
                                        style={{
                                            margin: "6px 0 0",
                                            fontSize: 13,
                                            color: "#C3C9D4",
                                            lineHeight: 1.4,
                                        }}
                                    >
                                        {activeHotspot.body}
                                    </p>
                                </>
                            )}
                        </motion.aside>
                    </div>
                </div>
            </section>

            <section style={{ maxWidth: 1180, margin: "0 auto", padding: "0 clamp(18px,4vw,60px) 24px" }}>
                <div style={{ fontSize: 11, letterSpacing: ".18em", color: "#9CA4B2" }}>ENGINEERED FOR IMMERSION</div>
                <div className="featureGrid" style={{ marginTop: 10, display: "grid", gridTemplateColumns: "repeat(4,minmax(0,1fr))", gap: 12 }}>
                    <FeatureCard title="Adaptive ANC" body="Real-time environmental sensing suppresses distraction while preserving musical detail." />
                    <FeatureCard title="40 mm custom drivers" body="Precision-tuned drivers deliver deep, articulate bass and effortless clarity." />
                    <FeatureCard title="Spatial audio" body="Immersive scene rendering places instruments and vocals in dimensional space." />
                    <FeatureCard title="38-hour battery" body="Extended endurance powers full-day listening with confident reserve." />
                </div>
            </section>

            <section style={{ maxWidth: 1180, margin: "0 auto", padding: "20px clamp(18px,4vw,60px) 20px" }}>
                <div className="dualGrid" style={{ display: "grid", gridTemplateColumns: "minmax(0,1fr) minmax(0,1fr)", gap: 20 }}>
                    <div style={{ border: "1px solid rgba(255,255,255,.14)", borderRadius: 20, padding: 22, background: "rgba(255,255,255,.03)", transition: "background .35s ease, border-color .35s ease" }}>
                        <h2 style={{ margin: 0, fontSize: "clamp(28px,4.5vw,44px)", letterSpacing: "-.04em" }}>Technical Specifications</h2>
                        <div style={{ marginTop: 8 }}>
                            <SpecificationItem value="40 mm" label="Custom drivers" />
                            <SpecificationItem value="38 hrs" label="Battery life" />
                            <SpecificationItem value="4 microphones" label="Voice isolation" />
                            <SpecificationItem value="32-bit" label="High-resolution audio" />
                            <SpecificationItem value="< 1%" label="Distortion" />
                            <SpecificationItem value="Bluetooth 5.4" label="Wireless standard" />
                        </div>
                    </div>
                    <RatingPanel accent={primaryAccent} reducedMotion={reducedMotion || isStatic} />
                </div>
            </section>

            <section style={{ maxWidth: 1180, margin: "0 auto", padding: "12px clamp(18px,4vw,60px) 40px" }}>
                <div style={{ borderRadius: 20, border: "1px solid rgba(255,255,255,.14)", padding: "clamp(18px,4vw,28px)", background: "rgba(255,255,255,.03)", transition: "background .35s ease, border-color .35s ease" }}>
                    <h2 style={{ margin: 0, fontSize: "clamp(28px,4.5vw,48px)", letterSpacing: "-.04em" }}>Made for the hours that matter.</h2>
                    <p style={{ margin: "10px 0 0", maxWidth: 740, color: "#AFB7C3", lineHeight: 1.6 }}>
                        Built for long listening arcs—morning focus blocks, late-night mixes, and travel in between. Comfort-first ergonomics, immersive driver tuning, and intelligent ANC keep you in the sound, not in the strain.
                    </p>
                </div>
            </section>

            <section style={{ maxWidth: 1180, margin: "0 auto", padding: "0 clamp(18px,4vw,60px) clamp(30px,6vw,72px)" }}>
                <div style={{ position: "relative", borderRadius: 24, border: "1px solid rgba(255,255,255,.14)", padding: "clamp(20px,5vw,36px)", overflow: "hidden", background: "rgba(255,255,255,.03)", transition: "background .35s ease, border-color .35s ease" }}>
                    <div style={{ position: "absolute", right: -60, bottom: -120, width: 360, height: 360, borderRadius: "50%", border: "28px solid rgba(255,255,255,.04)" }} />
                    <h2 style={{ position: "relative", margin: 0, fontSize: "clamp(30px,5vw,52px)", letterSpacing: "-.05em" }}>Stay in your own frequency.</h2>
                    <div style={{ position: "relative", marginTop: 16, display: "flex", gap: 10, flexWrap: "wrap" }}>
                        <CTAButton accent={primaryAccent} label="Explore Auralis One" ariaLabel="Reserve Auralis One now" />
                        <CTAButton secondary accent={primaryAccent} label="View specifications" ariaLabel="Compare Auralis models" />
                    </div>
                </div>
            </section>

